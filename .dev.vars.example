# Copy to .dev.vars for local development (`npm run dev`).
# In production, set each with: npx wrangler secret put <NAME>

# Required
API_TOKEN=pick-a-long-random-string          # protects the dashboard + admin API
GEMINI_API_KEY=                               # https://aistudio.google.com/apikey (free)
TELEGRAM_BOT_TOKEN=                           # main assistant bot, from @BotFather
TELEGRAM_ALERT_BOT_TOKEN=                     # optional 2nd bot for instant job alerts (@BotFather → /newbot again)
TELEGRAM_CHAT_ID=                             # your chat id (send /start to the bot, it replies with it)
TELEGRAM_WEBHOOK_SECRET=another-random-string

# Optional — fallback LLMs (any OpenAI-compatible API: Groq, OpenRouter, or local Ollama)
FALLBACK_LLM_BASE_URL=                        # e.g. https://api.groq.com/openai/v1  or  http://localhost:11434/v1
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=                           # e.g. llama-3.3-70b-versatile

# Optional — paid backup LLM, used only when the free providers fail (https://console.anthropic.com).
# A Claude Pro subscription does NOT include API credits; the API is billed separately.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5          # default; claude-haiku-5-5 is ~40x cheaper per token

# Optional — web search for the research agent (https://tavily.com, free tier)
TAVILY_API_KEY=

# Optional — Gmail API polling (only if you don't use Cloudflare Email Routing)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
